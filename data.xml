  <festival id="Festival-of-Darkness-2">
    <name>Festival of Darkness 2</name>
    <edition>2026</edition>
    <location>Kutna Hora, Czech Republic</location>
    <date_start>2026-07-10</date_start>
    <date_end>2026-07-12</date_end>
    <description>Three-day festival of electronic, alternative, and audiovisual music on two distinct stages.</description>
  </festival>

  <stages>
    <stage id="stage-solar">
      <name>Solar Horizon Stage</name>
      <capacity>4500</capacity>
      <type>Open-air main stage</type>
      <description>Central open-air amphitheater for major band performances, indie rock, and dance headliners.</description>
    </stage>
    <stage id="stage-lunar">
      <name>Lunar Forest Dome</name>
      <capacity>1800</capacity>
      <type>Covered audiovisual dome / marquee</type>
      <description>Atmospheric covered indoor stage focusing on techno, ambient, experimental electronics, and 360-degree light projections.</description>
    </stage>
  </stages>


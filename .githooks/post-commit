#!/bin/sh

JENKINS_URL="${JENKINS_URL:-http://localhost:8080}"
REPOSITORY_URL="${REPOSITORY_URL:-C:\Users\Administrator\Desktop\order\webapp\WebDesignFestival}"

curl.exe --fail --silent --show-error --max-time 10 --get \
  --data-urlencode "url=${REPOSITORY_URL}" \
  "${JENKINS_URL}/git/notifyCommit" \
  >/dev/null 2>&1

if [ $? -ne 0 ]; then
  echo "Jenkins notifyCommit failed; SCM polling will retry the commit." >&2
fi

#!/bin/sh

JENKINS_URL="${JENKINS_URL:-http://localhost:8080}"
JENKINS_AUTH_TOKEN="${JENKINS_AUTH_TOKEN:-local-commit}"

curl.exe --fail --silent --show-error --max-time 10 \
  "${JENKINS_URL}/job/school-website-ci/build?token=${JENKINS_AUTH_TOKEN}" \
  >/dev/null 2>&1

if [ $? -ne 0 ]; then
  echo "Jenkins trigger failed; SCM polling will retry the commit." >&2
fi
